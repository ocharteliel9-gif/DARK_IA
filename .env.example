NODE_ENV=development
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_SECRET=
DATABASE_URL=
OPENROUTER_API_KEY=
